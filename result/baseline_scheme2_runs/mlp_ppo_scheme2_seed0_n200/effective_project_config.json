  "algo": {
    "family": "PPO",
    "method_name": "EGDM-HGPPO",
    "encoder": {
      "type": "relation_aware_heterogeneous_graph_transformer"
    },
    "actor_heads": [
      "event_gate",
      "worker_cell_autoregressive_matcher",
      "robot_cell_autoregressive_matcher",
      "operation_cell_autoregressive_matcher"
    ],
    "matching_decoder": {
      "strategy": "masked_autoregressive_edge_selection",
