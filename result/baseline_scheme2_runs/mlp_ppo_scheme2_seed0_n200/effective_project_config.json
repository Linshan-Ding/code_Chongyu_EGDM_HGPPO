    "critic_heads": [
      "V_gate",
      "V_rec",
      "V_sch"
    ],
    "embed_dim": 128,
    "hgt_layers": 3,
    "attention_heads": 4,
    "relation_type_embed_dim": 32,
    "policy_value_mlp": [
      256,
      128
    ],
    "activation": "GELU",
    "layer_norm": true,
    "representation_network": {
      "node_categorical_embed_dim": 32,
      "pooling": "type_aware_attention",
      "relation_attention_uses_edge_features": true,
      "event_type_embed_dim": 32,
      "dropout": 0.0
    },
    "baselines": {
      "parameter_match": {
        "hidden_dim": 1024,
        "residual_blocks_per_type": 3
      }
    },
    "optimizer": "AdamW",
    "weight_decay": 1e-05,
    "learning_rate": 0.0003,
    "encoder_learning_rate": 0.0002,
    "lr_schedule": {
      "type": "linear_decay",
      "final_ratio": 0.1
    },
    "clip_eps": 0.2,
    "gamma": 0.995,
    "tau_0_minutes": 10.0,
    "gae_lambda": 0.95,
    "value_loss_coef": 0.5,
    "entropy": {
      "gate": {
        "start": 0.01,
        "end": 0.001
      },
      "matching": {
        "start": 0.02,
        "end": 0.002
      }
    },
    "parallel_envs": 32,
    "rollout_events": 8192,
    "minibatch_size": 512,
    "ppo_epochs": 4,
    "max_grad_norm": 0.5,
    "training_stabilization": {
      "advantage_normalization": true,
      "value_target_clipping": true,
      "entropy_annealing": true,
      "randomized_resource_decoding_order": false,
      "resource_decode_order_semantics": "global_edge_set_no_fixed_source_sequence",
      "validation_early_stopping": false
    },
    "ppo_implementation": {
      "policy_advantage_fusion": "mean_active_heads",
      "value_clip_eps": 0.2,
      "rollout_storage_device": "cpu",
      "shared_encoder_minibatch_replay": true,
      "mixed_precision": {
        "enabled": true,
        "dtype": "bf16"
      }
    },
    "num_training_seeds": 1,
    "training_seeds": [
      0
    ]
  },
